// Toy bracket replacement - parametric OpenSCAD model (v1, first guess, NOT yet test-fitted)
//
// Every number below comes from a caliper reading, a photo measurement or an explicit guess.
// The source and confidence of each value is listed in docs/measurements.md and docs/assumptions.md.
// Change values here (or via `openscad -D name=value`) - never scale the STL in the slicer
// unless you really mean "everything bigger".
//
// Coordinate system (millimetres):
//   x (u) : long axis, through both oval slots. Origin midway between the slots. Mirror-symmetric in x.
//   y (v) : across. +y = straight side of the square plate, -y = side where the two hooks point.
//   z     : thickness. z = 0 is the "face A" surface of the flat web (side with the SHORT tubes,
//           the shallow square rim and the thin X ribs). z = web_t is the "face B" surface
//           (side with the LONG tubes, the tall square frame and the deep X-ribbed pockets).
// The exported STL is shifted up so the tips of the face-A tubes sit on z = 0 (print face A down).

include <arm_outline.scad>   // generated by tools/trace_outline.py (outline of one hooked arm)

/* [Output] */
// What to render
part = "bracket"; // [bracket, fit_template]
// Keep the small cosmetic face-A details (square rim, thin X ribs, slot rims)
face_a_details = true;
// Curve resolution
$fn = 96;

/* [Plan view: holes and anchors] */
// Centre distance between the two oval slots (caliper: inner edges 34.27 + slot length)
slot_c2c = 40.0;
// Slot size along the long axis (x)
slot_len_x = 5.7;
// Slot size across (y)
slot_len_y = 7.6;
// Square plate size along x
square_x = 34.0;
// Square plate size along y
square_y = 33.7;
// Centre of the square plate in y (the slots sit 1.35 mm towards the hook side of it)
square_y_centre = 1.35;
// Corner radius of the square plate
square_corner_r = 2.0;
// Small rounded tabs on the hook-side corners of the square: centre x, width, how far they stick out
lug_x = 13.5;
lug_w = 6.5;
lug_protrusion = 2.0;
// Tube (pivot boss) centre, one per arm, mirrored in x
tube_x = 38.1;
tube_y = -9.45;
// Tube outer / inner diameter  (GUESS - measure the bore and the axle that goes in it)
tube_od = 10.0;
tube_id = 7.0;
// Solid pin next to each tube
peg_x = 29.4;
peg_y = -11.25;
peg_d = 4.7;
// Extra scale for the traced arm outline only (x, y). 1 = as traced.
arm_outline_scale = [1, 1];
// Fillet in the concave corners of the outline / rounding of convex corners
outline_inner_fillet = 0.8;
outline_outer_round = 0.4;

/* [Thickness and heights] */
// Flat web thickness (caliper: 3.06)
web_t = 3.06;
// Square frame + X ribs + slot rims height on face B, above the web (5.91 total - web - face A rim)
face_b_frame_h = 2.05;
// Wall thickness of the square frame on face B
face_b_frame_wall = 1.5;
// Width of the X ribs on face B
face_b_rib_w = 1.2;
// Face A: raised rim around the square and the slots
face_a_rim_h = 0.8;
face_a_rim_w = 1.2;
// Face A: thin X ribs on the square
face_a_rib_h = 0.6;
face_a_rib_w = 0.9;
// Width of the raised rings around the oval slots (both faces)
slot_rim_w = 1.2;
// Tube length sticking out of face A / face B  (GUESS from photos)
tube_len_a = 6.0;
tube_len_b = 12.0;
// Pin length sticking out of face A / face B  (GUESS from photos)
peg_len_a = 4.5;
peg_len_b = 9.0;

/* [Hidden] */
eps = 0.01;
sq_x0 = -square_x / 2;
sq_y0 = square_y_centre - square_y / 2;   // hook-side edge of the square
sq_y1 = square_y_centre + square_y / 2;   // straight-side edge of the square

assert(slot_len_y >= slot_len_x, "slots are modelled as stadiums elongated in y");
assert(tube_id < tube_od - 1.0, "tube wall thinner than 0.5 mm");
assert(abs(tube_x) - tube_od / 2 > slot_c2c / 2 + slot_len_x / 2, "tube overlaps the slot");
assert(peg_len_a <= tube_len_a, "pin longer than tube on face A changes the print base");

// ---------------------------------------------------------------- 2D building blocks

module rounded_rect(x0, y0, x1, y1, r) {
    hull() for (x = [x0 + r, x1 - r], y = [y0 + r, y1 - r]) translate([x, y]) circle(r = r);
}

module square_2d() { rounded_rect(sq_x0, sq_y0, -sq_x0, sq_y1, square_corner_r); }

module lug_2d() {
    r = min(lug_protrusion, lug_w / 2);
    for (s = [-1, 1]) translate([s * lug_x, sq_y0]) hull() {
        for (dx = [-(lug_w / 2 - r), lug_w / 2 - r]) translate([dx, r - lug_protrusion]) circle(r = r);
        translate([-lug_w / 2, 0]) square([lug_w, 1]);
    }
}

module arm_2d() { scale(arm_outline_scale) polygon(arm_outline_points); }

module outline_2d() {
    offset(r = outline_outer_round) offset(delta = -outline_outer_round)
    offset(r = -outline_inner_fillet) offset(delta = outline_inner_fillet)
    union() {
        square_2d();
        lug_2d();
        arm_2d();
        mirror([1, 0]) arm_2d();
    }
}

module slot_2d(grow = 0) {
    r = slot_len_x / 2 + grow;
    dy = slot_len_y / 2 - slot_len_x / 2;
    for (s = [-1, 1]) translate([s * slot_c2c / 2, 0]) hull() for (y = [-dy, dy]) translate([0, y]) circle(r = r);
}

module slot_rims_2d() { difference() { slot_2d(slot_rim_w); slot_2d(); } }

module through_holes_2d() {
    slot_2d();
    for (s = [-1, 1]) translate([s * tube_x, tube_y]) circle(d = tube_id);
}

module frame_2d(wall) { difference() { square_2d(); offset(delta = -wall) square_2d(); } }

module x_ribs_2d(w, wall) {
    // diagonals of the inner panel, clipped to it
    a = [sq_x0 + wall, sq_y0 + wall];
    b = [-sq_x0 - wall, sq_y1 - wall];
    intersection() {
        offset(delta = -wall + eps) square_2d();
        union() {
            hull() { translate(a) circle(d = w); translate(b) circle(d = w); }
            hull() { translate([b[0], a[1]]) circle(d = w); translate([a[0], b[1]]) circle(d = w); }
        }
    }
}

// ---------------------------------------------------------------- 3D

module bracket() {
    difference() {
        union() {
            // flat web
            linear_extrude(web_t) outline_2d();
            // face B (z > web_t): square frame, deep X ribs, slot rims, corner tabs
            translate([0, 0, web_t - eps]) linear_extrude(face_b_frame_h + eps) {
                frame_2d(face_b_frame_wall);
                x_ribs_2d(face_b_rib_w, face_b_frame_wall);
                slot_rims_2d();
                lug_2d();
            }
            // face A (z < 0): shallow rim, thin X ribs, slot rims, corner tabs
            if (face_a_details) {
                translate([0, 0, -face_a_rim_h]) linear_extrude(face_a_rim_h + eps) {
                    frame_2d(face_a_rim_w);
                    slot_rims_2d();
                    lug_2d();
                }
                translate([0, 0, -face_a_rib_h]) linear_extrude(face_a_rib_h + eps)
                    x_ribs_2d(face_a_rib_w, face_a_rim_w);
            }
            // tubes and pins, through the web, sticking out on both faces
            for (s = [-1, 1]) {
                translate([s * tube_x, tube_y, -tube_len_a]) cylinder(d = tube_od, h = tube_len_a + web_t + tube_len_b);
                translate([s * peg_x, peg_y, -peg_len_a]) cylinder(d = peg_d, h = peg_len_a + web_t + peg_len_b);
            }
        }
        translate([0, 0, -tube_len_a - 1]) linear_extrude(tube_len_a + web_t + tube_len_b + 2) through_holes_2d();
    }
}

// Thin flat copy of the outline with all holes, to lay on top of the original part and check the
// outline + hole positions before printing the real thing (prints in a few minutes).
// The tube and pin holes are 0.4 mm oversize so the original's tubes / pins poke through.
module fit_template(t = 1.0) {
    linear_extrude(t) difference() {
        outline_2d();
        slot_2d();
        for (s = [-1, 1]) {
            translate([s * tube_x, tube_y]) circle(d = tube_od + 0.4);
            translate([s * peg_x, peg_y]) circle(d = peg_d + 0.4);
        }
    }
}

echo(str("tube centre distance = ", 2 * tube_x, " mm, slot centre distance = ", slot_c2c, " mm"));
echo(str("total thickness at square = ", (face_a_details ? face_a_rim_h : 0) + web_t + face_b_frame_h,
         " mm (caliper 5.91), tube length = ", tube_len_a + web_t + tube_len_b, " mm"));

if (part == "bracket") translate([0, 0, tube_len_a]) bracket();
else if (part == "fit_template") fit_template();
